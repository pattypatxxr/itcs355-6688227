# ITCS355 Lab 3 — serving image
#
FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9 AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements-serve.txt ./
RUN pip install --prefix=/install --require-hashes -r requirements-serve.txt

FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9 AS runtime
RUN useradd --create-home --uid 10001 runner
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY --from=builder /install /usr/local
WORKDIR /app
COPY --chown=runner:runner service/ ./service/
COPY --chown=runner:runner src/ ./src/
COPY --chown=runner:runner cloudlayer/ ./cloudlayer/
COPY --chown=runner:runner monitoring/ ./monitoring/
COPY --chown=runner:runner scripts/make_dataset.py ./scripts/make_dataset.py
# Drift job reference data: regenerated deterministically (seed in make_dataset.py) because
# data/ is DVC-managed and excluded by .dockerignore. REFERENCE_CSV points the job here.
RUN python scripts/make_dataset.py --out /app/reference/sensors.csv
ENV REFERENCE_CSV=/app/reference/sensors.csv
USER runner

EXPOSE 8080
# Provider health/predict paths handled in cloudlayer/azure.py:
#   startup & readiness probes -> /ready ; liveness probe -> /health (lines ~280-284)
#   invoke() -> POST /predict or /predict/batch depending on payload shape (line ~342)
# in service/app.py — that is what makes the image non-portable.
# ONE worker on purpose: service/metrics.py keeps counters in process memory, and with
# several workers a scrape hits a random one, so counters jump and rate() is wrong.
CMD ["uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
